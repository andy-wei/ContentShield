# =============================================================================
# ContentShield 环境变量配置
# 复制为 .env 后按需修改。所有变量都有合理默认值，可直接 docker compose up。
# =============================================================================

# ---- 通用 ----
# 部署环境：dev / prod
ENV=dev
# 时区
TZ=Asia/Shanghai
# 后端服务监听端口
BACKEND_PORT=8000
# 前端服务端口
FRONTEND_PORT=5173
# 跨域允许来源（逗号分隔），生产环境务必收紧
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# 推理后端选择（核心配置）
# cloud    = Llama-Guard-4 走云 API（推荐，无需 GPU）
# local-gpu= 本地 vLLM（需要 NVIDIA GPU，约 24GB+ VRAM，或 AWQ 量化约 8-10GB）
# local-cpu= 本地 llama.cpp（GGUF INT4，纯 CPU，单次数秒，仅演示/离线）
# =============================================================================
INFERENCE_PROFILE=cloud

# =============================================================================
# Profile: cloud（Llama-Guard-4 走云 API）
# 默认使用 OpenRouter，也可改为 NVIDIA NIM / Together AI
# =============================================================================
# OpenRouter: https://openrouter.ai/  注册后在 Keys 页获取
LLAMA_GUARD_CLOUD_BASE_URL=https://openrouter.ai/api/v1
LLAMA_GUARD_CLOUD_API_KEY=
LLAMA_GUARD_CLOUD_MODEL=meta-llama/llama-guard-4-12b

# =============================================================================
# Profile: local-gpu（vLLM 服务）
# =============================================================================
VLLM_BASE_URL=http://vllm:8001
VLLM_API_KEY=not-needed
VLLM_MODEL=meta-llama/Llama-Guard-4-12B
# 已下载模型路径（vLLM 容器内）。可改成本地 AWQ 量化模型路径
VLLM_MODEL_PATH=/models/Llama-Guard-4-12B
# 显存占用上限比例
VLLM_GPU_MEMORY_UTILIZATION=0.90
# 上下文长度（Llama-Guard 输出极短，输入也不长，调小省显存）
VLLM_MAX_MODEL_LEN=8192

# =============================================================================
# Profile: local-cpu（llama.cpp GGUF 服务）
# =============================================================================
LLAMA_CPP_BASE_URL=http://llama-cpp:8080
LLAMA_CPP_API_KEY=not-needed
LLAMA_CPP_MODEL=llama-guard-4-12b
# GGUF 模型路径（容器内）
LLAMA_CPP_GGUF_PATH=/models/llama-guard-4-12b-Q4_K_M.gguf
# 并行线程数（建议=物理核心数）
LLAMA_CPP_THREADS=8

# =============================================================================
# Prompt Guard 2 86M（提示词注入/越狱检测，所有 profile 共用）
# 默认走内置 llama-cpp 轻量服务（CPU 足够，毫秒级）
# 也可指向独立 vLLM 实例：PROMPT_GUARD_BACKEND=vllm
# =============================================================================
PROMPT_GUARD_BACKEND=llama-cpp
PROMPT_GUARD_BASE_URL=http://llama-cpp-pg:8080
PROMPT_GUARD_API_KEY=not-needed
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
PROMPT_GUARD_GGUF_PATH=/models/Llama-Prompt-Guard-2-86M-Q8_0.gguf

# =============================================================================
# L4 交叉验证（OpenAI Compatible 通用大模型，补 Llama-Guard-4 盲区）
# 用一个通用大模型（GPT-4o/Claude/DeepSeek 等）交叉验证 HAP/恶意代码/越狱
# 默认 off，配置 API Key 后启用。命中时给 warn（补充意见，不直接 block）。
# =============================================================================
CROSS_VERIFY_BACKEND=off
CROSS_VERIFY_BASE_URL=https://api.openai.com/v1
CROSS_VERIFY_API_KEY=
CROSS_VERIFY_MODEL=gpt-4o-mini

# =============================================================================
# 网关代理：上游业务 LLM（OpenAI 兼容）
# 用于 /v1/chat/completions 代理转发，自动前后置审核
# =============================================================================
GATEWAY_ENABLED=true
GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
GATEWAY_UPSTREAM_API_KEY=
GATEWAY_UPSTREAM_MODEL=gpt-4o-mini
# 模式：pre=仅前置审核  post=仅后置审核  both=双向审核
GATEWAY_MODE=both

# =============================================================================
# 安全策略
# =============================================================================
# 注入检测阈值（Prompt Guard 2 给出的 INJECTION/JAILBREAK 概率，0-1）
PROMPT_GUARD_INJECTION_THRESHOLD=0.5
PROMPT_GUARD_JAILBREAK_THRESHOLD=0.5
# 审计入库时是否对命中 PII 片段打码（防二次泄露）
AUDIT_REDACT_PII=true
# 审计保留天数（0=永久）
AUDIT_RETENTION_DAYS=90
# 仪表盘最大回溯天数
STATS_LOOKBACK_DAYS=30

# =============================================================================
# 数据库（默认 SQLite，单文件零配置）
# 如需 PostgreSQL：改为 postgresql+asyncpg://user:pass@host:5432/db
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/contentshield.db

# =============================================================================
# 网关访问 API Key（逗号分隔，留空=不鉴权）
# 客户端调用 /v1/moderate 和 /v1/chat/completions 时用 Authorization: Bearer <key>
# =============================================================================
GATEWAY_API_KEYS=

# =============================================================================
# NHI 动态身份与凭据管理
# ENCRYPTION_KEY: Fernet 主密钥（base64）。必填以启用 NHI/OAuth 功能。
#   生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   留空=开发模式（降级 anonymous，不鉴权，不加密）
# =============================================================================
ENCRYPTION_KEY=
# JWT 配置（通常无需改）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=contentshield
